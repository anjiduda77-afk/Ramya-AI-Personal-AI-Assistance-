rules_version = '2';

// ===============================================================
// Ramya AI Production Cloud Firestore Security Rules
// ===============================================================
// Strict user-level access controls: users can only read and write
// their own profile, conversations, messages, RAG documents, memories,
// and preferences.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and ownership helpers
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data, userId) {
      return data.uid == userId
        && data.providerId is string
        && (!('displayName' in data) || data.displayName is string)
        && (!('email' in data) || data.email is string)
        && (!('photoUrl' in data) || data.photoUrl is string);
    }

    function isValidConversation(data) {
      return (!('id' in data) || data.id is string)
        && (!('title' in data) || data.title is string)
        && (!('userTranscript' in data) || data.userTranscript is string)
        && (!('assistantResponse' in data) || data.assistantResponse is string);
    }

    function isValidMessage(data) {
      return data.sender is string
        && data.text is string;
    }

    function isValidDocument(data) {
      return data.name is string
        && (!('sizeBytes' in data) || data.sizeBytes is number)
        && (!('chunkCount' in data) || data.chunkCount is number);
    }

    function isValidMemory(data) {
      return data.memoryText is string
        && (!('category' in data) || data.category is string);
    }

    function isValidPreference(data) {
      return (!('theme' in data) || data.theme is string)
        && (!('voiceRate' in data) || data.voiceRate is number)
        && (!('voicePitch' in data) || data.voicePitch is number)
        && (!('backgroundListening' in data) || data.backgroundListening is bool);
    }

    // User Profile Document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // User Multi-Chat Conversations Subcollection
      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidConversation(request.resource.data);
        allow delete: if isOwner(userId);

        // Messages Subcollection within a Conversation
        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidMessage(request.resource.data);
          allow delete: if isOwner(userId);
        }
      }

      // User Knowledge Base RAG Documents Subcollection
      match /documents/{documentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDocument(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User Personal Memories Subcollection
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMemory(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // User Preferences Subcollection
      match /preferences/{prefId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPreference(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
