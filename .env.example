# ==============================================================================
# RAMYA AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your deployment secrets.
# Never commit the .env file containing live secrets to public version control.
# ==============================================================================

# --- FastApi Server Settings ---
RAMYA_HOST=127.0.0.1
RAMYA_PORT=8000
RAMYA_DEBUG=true
RAMYA_SECRET_KEY=replace-with-a-random-secure-string-at-least-32-chars

# --- Local AI Engine (Offline First) ---
RAMYA_DEFAULT_PROVIDER=ollama
RAMYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAMYA_OLLAMA_MODEL=gemma3:4b

# --- Cloud AI Providers (Optional Multi-Cloud Fallback) ---
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# xAI Grok API
XAI_API_KEY=
XAI_MODEL=grok-beta

# --- Supabase Cloud Database & Authentication ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for client with Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Backend Only - NEVER expose to frontend or Android APK)
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud OAuth Configuration ---
# Web Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Voice & Speech Engine Settings ---
RAMYA_LANGUAGE=en-IN
RAMYA_VOICE_NAME=en-IN-NeerjaNeural
RAMYA_TTS_ENGINE=edge-tts
RAMYA_STT_ENGINE=faster-whisper
RAMYA_VAD_THRESHOLD=0.5

# --- Security & Permissions ---
RAMYA_AUTO_APPROVE_LOW_RISK=true
RAMYA_REQUIRE_HIGH_RISK_CONFIRMATION=true
