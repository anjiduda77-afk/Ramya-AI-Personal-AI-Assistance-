# =====================================================================
# RAMYA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure as needed.
# =====================================================================

# Server & Network Configuration
RAMYA_HOST=127.0.0.1
RAMYA_PORT=8000
RAMYA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost","http://localhost:3000"]
RAMYA_DEBUG=true
RAMYA_SECRET_KEY=change-in-production-ramya-ai-super-secret-key-32chars

# Voice & Speech Pipeline
RAMYA_WAKE_WORDS=["hey ramya","hello ramya","ramya","okey ramya"]
RAMYA_PRIMARY_WAKE_WORD="Hey Ramya"
RAMYA_LANGUAGE=en-IN
RAMYA_VOICE_NAME=en-IN-NeerjaNeural
RAMYA_TTS_ENGINE=edge-tts
RAMYA_STT_ENGINE=faster-whisper
RAMYA_WHISPER_MODEL_SIZE=tiny
RAMYA_VAD_THRESHOLD=0.5
RAMYA_MIC_AUTO_LISTEN=true

# AI Provider Configuration
RAMYA_DEFAULT_PROVIDER=ollama
RAMYA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAMYA_OLLAMA_MODEL=gemma3:4b
RAMYA_CLOUD_PROVIDER=gemini
RAMYA_CLOUD_API_KEY=
RAMYA_CLOUD_MODEL=gemini-1.5-flash

# SQLite Database & Storage
RAMYA_DB_PATH=data/ramya.db
RAMYA_STORAGE_DIR=storage

# Live Data APIs (No API key required for default Open-Meteo)
RAMYA_WEATHER_LOCATION=Hyderabad, India
RAMYA_STOCKS_WATCHLIST=["RELIANCE.NS","TCS.NS","INFY.NS","NVDA","AAPL","GOOGL"]

# Security & Permissions
RAMYA_AUTO_APPROVE_LOW_RISK=true
RAMYA_REQUIRE_HIGH_RISK_CONFIRMATION=true
